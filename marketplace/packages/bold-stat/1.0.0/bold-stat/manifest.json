{
  "id": "bold-stat",
  "name": "Bold Statistic",
  "version": "1.0.0",
  "author": "acme",
  "apiVersion": "1",
  "kind": "stat",
  "description": "Bold statistic with count-up.",
  "tags": [
    "stat",
    "number"
  ],
  "license": "MIT",
  "inputSchema": {
    "type": "object",
    "properties": {
      "value": {
