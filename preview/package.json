    "next": "15.5.19",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.472",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.5.0",
    "postcss": "8.5.15",
    "tailwindcss": "3.4.19",
