{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "types": ["react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"],
      "react-dom": ["node_modules/@types/react-dom"],
      "react-dom/*": ["node_modules/@types/react-dom/*"],
      "remotion": ["node_modules/remotion"],
      "remotion/*": ["node_modules/remotion/*"],
      "@remotion/transitions": ["node_modules/@remotion/transitions"],
      "@remotion/transitions/*": ["node_modules/@remotion/transitions/*"],
      "lucide-react": ["node_modules/lucide-react/dist/lucide-react.d.ts"]
    }
  },
  "include": ["src", "remotion.config.ts", "../templates/**/*.ts", "../templates/**/*.tsx"]
}
