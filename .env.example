# Faceless Video Generator — environment variables (template).
# Copy this file to `.env` and fill in the secrets. `.env` is gitignored;
# this `.env.example` is committed so others know what to set.
# Loaded by the Python backend via python-dotenv (run from the repo root).

# ── Script LLM (pluggable provider) ───────────────────────────────────────────
# deepseek (default, paid) | ollama (free, local) | anthropic (optional, paid)
LLM_PROVIDER=deepseek

# --- deepseek (default) — OpenAI-compatible API at api.deepseek.com ---
DEEPSEEK_API_KEY=                          # required when LLM_PROVIDER=deepseek (platform.deepseek.com)
DEEPSEEK_MODEL=deepseek-chat               # OpenAI-compatible model id
DEEPSEEK_BASE_URL=https://api.deepseek.com # endpoint for the openai SDK

# --- anthropic (optional) ---
ANTHROPIC_API_KEY=                         # only if LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- ollama (optional, free/local) ---
OLLAMA_MODEL=llama3.1                      # only if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# ── Footage ───────────────────────────────────────────────────────────────────
PEXELS_API_KEY=                            # required for the footage stage (free at pexels.com/api)

# ── Pipeline config (optional overrides — sensible defaults baked into the code)
# SPEC_PATH=spec.json                      # output contract the renderer/preview reads
# TTS_VOICE=af_heart                       # Kokoro voice
