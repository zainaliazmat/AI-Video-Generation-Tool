{
  "id": "stat",
  "name": "Stat Callout",
  "version": "1.0.0",
  "author": "core",
  "apiVersion": "1",
  "kind": "stat",
  "description": "Statistic hero card with count-up number animation.",
  "tags": [
    "stat",
    "number",
    "hero"
  ],
  "inputSchema": {
    "type": "object",
    "properties": {
      "value": {
        "type": "string"
      },
      "label": {
        "type": "string"
      },
      "icon": {
        "type": "string"
      },
      "backgroundClip": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "video",
              "image"
            ]
          },
          "src": {
            "type": "string"
          },
          "fit": {
            "type": "string",
            "enum": [
              "cover",
              "contain"
            ],
            "default": "cover"
          },
          "kenBurns": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "number"
                  },
                  "to": {
                    "type": "number"
                  },
                  "originX": {
                    "type": "number"
                  },
                  "originY": {
                    "type": "number"
                  }
                },
                "required": [
                  "from",
                  "to",
                  "originX",
                  "originY"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "loop": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "type",
          "src"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "value",
      "label"
    ],
    "additionalProperties": false
  },
  "sampleProps": {
    "value": "90%",
    "label": "of the ocean is unexplored",
    "icon": "🌊"
  },
  "durationFrames": {
    "min": 45,
    "max": 120
  },
  "rendersOwnText": true
}
