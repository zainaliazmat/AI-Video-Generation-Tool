{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "react": ["../remotion/node_modules/@types/react"],
      "react/*": ["../remotion/node_modules/@types/react/*"],
      "@remotion/transitions": ["../remotion/node_modules/@remotion/transitions"],
      "@remotion/transitions/*": ["../remotion/node_modules/@remotion/transitions/*"]
    }
  },
  "comment": "Standalone check of the SDK contract + each template's zod schema.ts (zod is the one runtime dep present here). Template COMPONENTS import remotion/react and are typechecked through the consumers (remotion + preview) that have those installed; templates/ keeps no react/remotion node_modules of its own.",
  "include": ["sdk.ts", "mediaSchema.ts", "*/schema.ts"],
  "exclude": ["node_modules"]
}
