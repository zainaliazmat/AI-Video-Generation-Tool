{
  "id": "scene",
  "name": "Scene — Footage + Ken Burns",
  "version": "1.0.0",
  "author": "core",
  "apiVersion": "1",
  "kind": "scene",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "media": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["video", "image"] },
          "src": { "type": "string" },
          "fit": { "enum": ["cover", "contain"] },
          "kenBurns": {
            "type": ["object", "null"],
            "properties": {
              "from": { "type": "number" },
              "to": { "type": "number" },
              "originX": { "type": "number" },
              "originY": { "type": "number" }
            }
          },
          "loop": { "type": "boolean" }
        },
        "required": ["type", "src", "fit"]
      }
    },
    "required": ["media"]
  },
  "sampleProps": {
    "media": {
      "type": "video",
      "src": "assets/clip-1.mp4",
      "fit": "cover",
      "kenBurns": { "from": 1.0, "to": 1.12, "originX": 0.5, "originY": 0.4 }
    }
  },
  "durationFrames": { "min": 30, "max": 300 }
}
