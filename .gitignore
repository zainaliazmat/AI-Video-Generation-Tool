# vendored gstack tooling — project-local install (~1 GB incl. node_modules +
# a 94 MB browse binary). Re-run ./setup to regenerate after a fresh clone.
.claude/skills/

# dependencies / build output
node_modules/
.venv/
__pycache__/
*.pyc
.next/
*.tsbuildinfo
remotion/out/
out/

# secrets / env
.env
.env.local
.env.*.local

# generated at runtime (real runs overwrite the dummy skeleton assets)
/spec.json
# grounding citation sidecar (generated per run, like spec.json)
/sources.json
# grounding: Tavily retrieval cache (results cached by query, like the footage cache)
.cache/
# template registry codegen (regenerated by build-registry on dev/build/render/studio)
templates/registry.generated.ts
# stock footage downloaded by the Phase 4 pipeline (regenerated per run)
remotion/public/assets/footage_*.mp4
# A.2b user-uploaded media staged by the upload op (video OR image, content-hashed)
remotion/public/assets/footage_upload_*
# spec copied into remotion/public/ by the copy-spec script (source of truth is root)
remotion/public/sample-spec.json
remotion/public/spec.json
# preview app generated copies (mirrored from remotion/public + root by copy-assets)
preview/public/assets/
preview/public/template-assets/
preview/public/sample-spec.json
preview/public/spec.json
preview/next-env.d.ts

# OS / editor
.DS_Store
.gstack/

# footage duration sidecars (cache, like the .mp4s)
remotion/public/assets/*.frames

# footage provenance sidecars (A.2a cache, like the .mp4s / .frames)
remotion/public/assets/*.prov.json

# remotion bundle output
remotion/build/

# review / gate scratch — frame strips, contact-sheet zips, listen renders, and
# the real TTS wavs the gate harness produces. Pure review artifacts; never pushed.
*-review-frames.zip
*-review-frames/
*-review.zip
*-review/
hook-gate-frames/
hook-wordsync-gate-frames.zip
hook-wordsync-gate-frames/
hook-wordsync-listen-*.mp4
remotion/public/assets/hook-gate-*.wav
enumeration-gate-frames/
enumeration-gate-frames*/
enumeration-gate-frames*.zip
remotion/public/assets/enum-gate-*.wav

# the generated TTS voiceover — the voice stage rewrites it every run; only its
# path string is referenced in specs, never the binary. Same class as the gate wavs.
remotion/public/assets/voiceover.wav
# project-scoped voiceovers (studio voice gate, suffixed by project id) — same class
remotion/public/assets/voiceover_auto-*.wav
# studio voice-gate preview clips (generated per voice on demand) — same class
remotion/public/assets/voice_preview_*.wav

# local repro / bakeoff scratch specs (throwaway debugging fixtures)
bakeoff-*.json
repro-*.json

# HITL session store (runtime state)
backend/.sessions/

# project library store (Phase 5 session=project runtime state, per-project dirs)
/projects/

# template installer staging area (M2 installer candidate packages, mid-install sentinels)
templates/.staging/

# pack-template output — deterministic zips built from doctor-clean templates
templates/dist/

# marketplace built zips — regenerated by build-marketplace-index (gitignored build artifact)
marketplace/packages/**/*.zip
